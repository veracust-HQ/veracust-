# Supabase credentials: keep the secret/service-role key only on the API host.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the publishable key (sb_publishable_...) or legacy anon JWT.
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY
# Use the secret key (sb_secret_...) or legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Inference service. The config defaults to configs/default_config.yaml.
VERACUST_CHECKPOINT=
VERACUST_MAX_UPLOAD_BYTES=52428800
VERACUST_ANONYMOUS_MONTHLY_CREDITS=1000
VERACUST_COOKIE_SECURE=true
VERACUST_CORS_ORIGINS=https://YOUR_DASHBOARD_DOMAIN
